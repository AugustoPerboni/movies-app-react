{
  "eslint.enable": false,
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "never"
  },
  "eslint.run": "onSave",
  "eslint.workingDirectories": [
    {
      "directory": "front",
      "changeProcessCWD": true
    }
  ],
  "eslint.validate": [],
  "prettier.requireConfig": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/back/.venv/bin/python",
  "python.envFile": "${workspaceFolder}/back/.env",
  "python.terminal.useEnvFile": false,
  "python.analysis.extraPaths": ["${workspaceFolder}/back"],
  "python.terminal.executeInFileDir": false,
  "terminal.integrated.cwd": "${workspaceFolder}/back",
  "terminal.integrated.env.linux": {
    "PYTHONPATH": "${workspaceFolder}/back:${env:PYTHONPATH}"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  }
}
